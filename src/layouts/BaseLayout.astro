---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.defaultDescription } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&amp;family=Noto+Sans+JP:wght@400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
