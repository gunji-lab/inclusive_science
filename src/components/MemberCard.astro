---
import type { Member } from "../data/members";

interface Props {
  member: Member;
  compact?: boolean;
}

const { member, compact = false } = Astro.props;
const initials = member.nameEn
  ? member.nameEn.split(" ").map((part) => part[0]).join("").slice(0, 2)
  : member.nameJa.replace(/\s/g, "").slice(0, 1);
---

<article class:list={["member-card", { "member-card-compact": compact }]}>
  <div class="member-photo">
    {member.photo ? (
      <img src={member.photo} alt={`${member.nameJa}の写真`} loading="lazy" />
    ) : (
      <span aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="member-details">
    {member.roles.length > 0 && <p class="member-role">{member.roles.join(" / ")}</p>}
    <h3>{member.nameJa}</h3>
    {member.nameEn && <p class="member-name-en">{member.nameEn}</p>}
    <p class="member-affiliation">{member.affiliation}{member.position && <>　{member.position}</>}</p>
    {member.specialty && <p class="member-specialty">{member.specialty}</p>}
    {member.profileUrl && (
      <a class="member-link" href={member.profileUrl} target="_blank" rel="noreferrer">
        研究者情報を見る <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>

<style>
  .member-card{display:grid;grid-template-columns:124px minmax(0,1fr);gap:28px;padding:30px 0;border-top:1px solid var(--line)}
  .member-photo{aspect-ratio:1;display:grid;place-items:center;overflow:hidden;border-radius:50%;background:linear-gradient(145deg,#e7e4da,#dce6df);color:var(--sage)}
  .member-photo img{width:100%;height:100%;object-fit:cover}
  .member-photo span{font:700 24px var(--sans);letter-spacing:.08em}
  .member-details{align-self:center}
  .member-role{margin:0 0 7px;color:var(--coral);font-size:14px;font-weight:700;letter-spacing:.04em}
  h3{margin:0;font-size:25px;line-height:1.45;font-weight:600;letter-spacing:-.02em}
  .member-name-en{margin:2px 0 13px;color:var(--muted);font:600 13px var(--sans);letter-spacing:.07em}
  .member-affiliation{margin:0;font-size:15px;line-height:1.75}
  .member-specialty{margin:12px 0 0;color:var(--muted);font-size:15px;line-height:1.75}
  .member-link{display:inline-block;margin-top:15px;color:#55755e;font-size:14px;font-weight:600;text-underline-offset:5px}
  .member-card-compact{grid-template-columns:92px minmax(0,1fr);gap:22px;padding:25px 0}
  .member-card-compact h3{font-size:22px}
  @media(max-width:660px){.member-card,.member-card-compact{grid-template-columns:78px minmax(0,1fr);gap:18px}.member-card{padding:26px 0}.member-photo span{font-size:18px}h3,.member-card-compact h3{font-size:21px}.member-affiliation,.member-specialty{font-size:14px}}
</style>
