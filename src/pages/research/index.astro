---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const research = await getCollection("research");
const categories = [
  { id: "presentation", number: "01", label: "PRESENTATIONS", title: "学会発表" },
  { id: "publication", number: "02", label: "PUBLICATIONS", title: "査読論文" },
] as const;
---

<BaseLayout title="研究成果" description="インクルーシブ・サイエンスプロジェクトの学会発表および査読論文をご紹介します。">
  <section class="research-page" aria-labelledby="research-title">
    <div class="research-container">
      <header class="research-heading">
        <p class="eyebrow">RESEARCH</p>
        <h1 id="research-title">研究成果</h1>
        <p>本プロジェクトの研究成果を掲載予定です。</p>
      </header>

      <div class="research-categories">
        {categories.map((category) => {
          const entries = research
            .filter((entry) => entry.data.category === category.id)
            .sort((a, b) => b.data.year - a.data.year);
          return (
            <section class="research-category" aria-labelledby={`${category.id}-title`}>
              <header>
                <p class="category-number">{category.number}</p>
                <div>
                  <p class="category-label">{category.label}</p>
                  <h2 id={`${category.id}-title`}>{category.title}</h2>
                </div>
              </header>
              {entries.length > 0 ? (
                <ul>
                  {entries.map((entry) => (
                    <li>
                      <span>{entry.data.year}</span>
                      <div>
                        <h3>{entry.data.title}</h3>
                        {entry.data.authors.length > 0 && <p>{entry.data.authors.join("、")}</p>}
                        {entry.data.externalUrl && <a href={entry.data.externalUrl} target="_blank" rel="noreferrer">詳細を見る ↗</a>}
                      </div>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty-message">掲載準備中です。</p>
              )}
            </section>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-page{min-height:calc(100vh - 130px);padding:158px 24px 110px;background:var(--paper)}
  .research-container{width:min(var(--content),100%);margin-inline:auto}
  .research-heading{max-width:var(--reading);margin:0 auto 64px}
  .research-heading h1{margin:12px 0 20px;font-size:clamp(42px,5vw,58px);line-height:1.35;letter-spacing:-.035em;font-weight:600}
  .research-heading>p:last-child{margin:0;font-size:18px;line-height:1.9}
  .research-categories{max-width:var(--reading);margin-inline:auto}
  .research-category{padding:44px 0 48px;border-top:1px solid var(--line)}
  .research-category:last-child{border-bottom:1px solid var(--line)}
  .research-category>header{display:grid;grid-template-columns:72px minmax(0,1fr);gap:22px;align-items:start}
  .category-number{margin:5px 0 0;color:var(--sage);font:700 32px/1 var(--sans)}
  .category-label{margin:0 0 5px;color:var(--muted);font:700 12px var(--sans);letter-spacing:.1em}
  .research-category h2{margin:0;font-size:28px;line-height:1.5;font-weight:600}
  .empty-message{margin:28px 0 0;padding-left:94px;color:var(--muted);font-size:16px}
  .research-category ul{margin:30px 0 0;padding:0;list-style:none}
  .research-category li{display:grid;grid-template-columns:72px minmax(0,1fr);gap:22px;padding:24px 0;border-top:1px solid var(--line)}
  .research-category li>span{color:var(--muted);font:600 14px var(--sans)}
  .research-category h3{margin:0;font-size:18px;line-height:1.7;font-weight:600}
  .research-category li p{margin:7px 0 0;color:var(--muted);font-size:15px}
  .research-category li a{display:inline-block;margin-top:9px;color:#55755e;font-size:14px;font-weight:600;text-underline-offset:5px}
  @media(max-width:660px){.research-page{padding:125px 20px 80px}.research-heading{margin-bottom:44px}.research-heading>p:last-child{font-size:17px}.research-category{padding:36px 0 40px}.research-category>header{grid-template-columns:54px minmax(0,1fr);gap:14px}.category-number{font-size:27px}.research-category h2{font-size:24px}.empty-message{padding-left:68px}.research-category li{grid-template-columns:54px minmax(0,1fr);gap:14px}}
</style>
