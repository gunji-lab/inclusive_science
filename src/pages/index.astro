---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { teams } from "../data/teams";

const latestNews = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
---

<BaseLayout
  title="ホーム"
  description="多様性を理解し、つなぎ、活かす新しい科学。東洋大学重点研究推進プロジェクト『インクルーシブ・サイエンス』の公式サイトです。"
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <p class="hero-kicker">TOYO UNIVERSITY RESEARCH PROJECT</p>
      <h1 id="home-title">多様性を、<br /><em>力に変える。</em></h1>
      <p class="hero-lead">見過ごされてきた一つひとつの違いに目を向け、<br />生命・環境・社会の新しい関係をひらきます。</p>
      <p class="project-name">インクルーシブ・サイエンスの創成</p>
      <a class="hero-link" href="/about/">プロジェクトについて <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section vision-section" id="vision" aria-labelledby="vision-title">
    <div class="home-container">
      <header>
        <p class="section-label">OUR VISION</p>
        <h2 id="vision-title">違いを、科学の中心へ。</h2>
      </header>
      <div class="vision-copy">
        <p>私たち一人ひとりが異なるように、生きものの形や機能、環境への応答にも、さまざまな「違い」があります。生態系や社会もまた、多様な要素の相互作用によって成り立っています。</p>
        <p>本プロジェクトは、これまで「ばらつき」として扱われることもあった個体差や地域差に目を向け、その違いが生命・生態系・社会の持続性にどのような意味を持つのかを３つの視点からひもときます。</p>
      </div>
      <div class="field-list">
        {teams.map((team) => (
          <article class:list={["field-item", `field-${team.color}`]}>
            <p class="field-number">{team.number}</p>
            <div class="field-title">
              <p>{team.labelEn}</p>
              <h3>{team.name}</h3>
            </div>
            <p class="field-theme">{team.theme}</p>
          </article>
        ))}
      </div>
      <a class="text-link fields-link" href="/about/#teams">研究領域について詳しく見る <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section news-section" aria-labelledby="home-news-title">
    <div class="home-container">
      <header class="home-section-heading news-heading">
        <div>
          <p class="section-label">NEWS</p>
          <h2 id="home-news-title">お知らせ</h2>
        </div>
        <a class="text-link" href="/news/">一覧を見る <span aria-hidden="true">→</span></a>
      </header>
      <div class="news-window" aria-label="最新のお知らせから順に表示">
        <div class="news-track" id="news-track">
          {latestNews.map((entry) => (
            <article class="news-card">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h3><a href={`/news/${entry.id}/`}>{entry.data.title}<span aria-hidden="true">→</span></a></h3>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const vision = document.getElementById("vision");
    if (!vision || location.hash || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let cancelled = false;
    const cancel = () => { cancelled = true; };
    for (const eventName of ["wheel", "touchstart", "mousedown", "keydown"]) {
      window.addEventListener(eventName, cancel, { once: true, passive: true });
    }
    window.setTimeout(() => {
      if (!cancelled && window.scrollY < 20 && document.visibilityState === "visible") {
        vision.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }, 2000);
  })();

  (() => {
    const track = document.getElementById("news-track");
    if (!track || track.children.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const windowEl = track.parentElement;
    let moving = false;
    const slide = () => {
      if (moving || !windowEl || windowEl.matches(":hover") || windowEl.matches(":focus-within")) return;
      const first = track.firstElementChild;
      if (!first) return;
      moving = true;
      const clone = first.cloneNode(true);
      clone.setAttribute("aria-hidden", "true");
      clone.setAttribute("inert", "");
      track.appendChild(clone);
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = first.getBoundingClientRect().width + gap;
      requestAnimationFrame(() => {
        track.style.transition = "transform .7s ease";
        track.style.transform = `translateX(-${distance}px)`;
      });
      window.setTimeout(() => {
        track.appendChild(first);
        clone.remove();
        track.style.transition = "none";
        track.style.transform = "";
        moving = false;
      }, 750);
    };
    window.setInterval(slide, 5000);
  })();
</script>

<style>
  .home-hero{position:relative;min-height:760px;padding:170px 24px 105px;display:flex;align-items:center;overflow:hidden;background:#faf8f1}
  .hero-inner{position:relative;z-index:2;width:min(var(--content),100%);margin-inline:auto}
  .hero-kicker,.section-label{margin:0;color:var(--sage);font:700 13px var(--sans);letter-spacing:.12em}
  .home-hero h1{max-width:760px;margin:25px 0 28px;font-size:clamp(50px,6vw,78px);line-height:1.28;letter-spacing:-.04em;font-weight:600}
  .home-hero h1 em{color:var(--sage);font-style:normal}
  .hero-lead{max-width:650px;margin:0;font-size:20px;line-height:1.95;letter-spacing:.015em}
  .project-name{margin:28px 0 0;color:var(--muted);font-size:15px;font-weight:600;letter-spacing:.04em}
  .hero-link{display:inline-flex;align-items:center;gap:18px;margin-top:38px;padding-bottom:7px;border-bottom:1px solid var(--ink);font-size:15px;font-weight:600;text-decoration:none}
  .hero-link span,.text-link span{transition:transform .2s}
  .hero-link:hover span,.hero-link:focus-visible span,.text-link:hover span,.text-link:focus-visible span{transform:translateX(5px)}
  .home-section{padding:38px 24px 44px}
  .home-container{width:min(var(--content),100%);margin-inline:auto}
  .vision-section{background:var(--white);scroll-margin-top:82px}
  .vision-section h2,.home-section-heading h2{margin:8px 0 0;font-size:clamp(34px,4vw,43px);line-height:1.3;letter-spacing:-.025em;font-weight:600}
  .vision-section h2{white-space:nowrap}
  .vision-copy{width:100%;margin:16px 0 20px}
  .vision-copy p{margin:0 0 .55em;font-size:16px;line-height:1.65}
  .vision-copy p:last-child{margin-bottom:0}
  .text-link{display:inline-flex;align-items:center;gap:14px;margin-top:13px;color:#55755e;font-size:15px;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(85,117,94,.45)}
  .home-section-heading{margin:0 0 16px}
  .field-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;width:100%}
  .field-item{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-width:0;padding:14px 18px 16px;background:var(--green-white);border-top:2px solid var(--line)}
  .field-number{position:absolute;top:14px;right:18px;margin:0;font:700 22px/1 var(--sans)}
  .field-title{padding-right:34px}
  .field-title>p{margin:0 0 5px;color:var(--muted);font:700 11px var(--sans);letter-spacing:.08em}
  .field-title h3{margin:0;font-size:16px;line-height:1.4;font-weight:600}
  .field-theme{margin:0;font-size:14px;font-weight:600;line-height:1.45}
  .field-red .field-number,.field-red .field-theme{color:var(--coral)}
  .field-green .field-number,.field-green .field-theme{color:var(--sage)}
  .field-blue .field-number,.field-blue .field-theme{color:var(--blue)}
  .fields-link{display:flex;width:max-content;margin:14px 0 0}
  .news-section{background:var(--paper)}
  .news-heading{display:flex;align-items:end;justify-content:space-between}
  .news-heading .text-link{margin-bottom:8px}
  .news-window{overflow:hidden}
  .news-track{display:flex;gap:20px}
  .news-card{flex:0 0 calc((100% - 40px)/3);min-width:0;padding:22px 24px 26px;background:var(--white);border-top:2px solid var(--sage)}
  .news-card time{color:var(--muted);font:600 12px var(--sans);letter-spacing:.04em}
  .news-card h3{margin:11px 0 0;font-size:17px;line-height:1.55;font-weight:600}
  .news-card h3 a{display:flex;gap:12px;color:inherit;text-decoration:none}
  .news-card h3 a span{margin-left:auto;color:var(--sage)}
  .news-card h3 a:hover,.news-card h3 a:focus-visible{color:var(--sage)}
  @media(max-width:900px){.news-card{flex-basis:calc((100% - 20px)/2)}.field-item{padding:16px}.field-title h3{font-size:16px}.field-theme{font-size:14px}}
  @media(max-width:760px){.field-list{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.field-item{flex:0 0 min(76vw,310px);scroll-snap-align:start}}
  @media(max-width:660px){.home-hero{min-height:700px;padding:135px 20px 82px;align-items:flex-start}.home-hero h1{margin-top:24px;font-size:clamp(42px,9vw,50px);line-height:1.3}.hero-lead{font-size:17px}.hero-lead br{display:none}.project-name{max-width:260px;line-height:1.7}.home-section{padding:30px 20px 38px}.vision-section{scroll-margin-top:70px}.vision-section h2{font-size:clamp(21px,6vw,31px)}.home-section-heading h2{font-size:28px}.vision-copy{margin:15px 0 18px}.vision-copy p{font-size:15px;line-height:1.6}.home-section-heading{margin-bottom:16px}.field-item{padding:14px 16px}.field-number{top:14px;right:16px;font-size:22px}.field-title>p{font-size:10px}.field-title h3{font-size:16px}.field-theme{font-size:14px}.news-card{flex-basis:100%}}
</style>
