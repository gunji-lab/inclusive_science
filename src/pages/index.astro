---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { teams } from "../data/teams";

const latestNews = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
---

<BaseLayout
  title="ホーム"
  description="多様性を理解し、つなぎ、活かす新しい科学。東洋大学重点研究推進プロジェクト『インクルーシブ・サイエンス』の公式サイトです。"
>
  <div class="home-intro" id="home-intro" role="dialog" aria-label="サイトの紹介">
    <div class="home-intro-inner">
      <p class="hero-kicker">TOYO UNIVERSITY RESEARCH PROJECT</p>
      <p class="intro-title">多様性を、<br /><em>力に変える。</em></p>
      <button class="intro-skip" id="intro-skip" type="button">トップページを見る <span aria-hidden="true">→</span></button>
    </div>
  </div>
  <noscript><style>.home-intro{display:none!important}</style></noscript>

  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">TOYO UNIVERSITY RESEARCH PROJECT</p>
        <h1 id="home-title">インクルーシブ・サイエンスの創生</h1>
        <h2 class="hero-subtitle">違いを、科学の中心へ。</h2>
        <div class="hero-description">
          <p>私たち一人ひとりが異なるように、生きものの形や機能、環境への応答にも、さまざまな「違い」があります。生態系や社会もまた、多様な要素の相互作用によって成り立っています。</p>
          <p>本プロジェクトは、これまで「ばらつき」として扱われることもあった個体差や地域差に目を向け、その違いが生命・生態系・社会の持続性にどのような意味を持つのかを明らかにします。</p>
        </div>
        <nav class="hero-links" aria-label="主なページ">
          <a class="hero-link" href="/about/">プロジェクトについて <span aria-hidden="true">→</span></a>
          <a class="hero-link" href="/people/">組織について <span aria-hidden="true">→</span></a>
          <a class="hero-link" href="/research/">研究成果一覧 <span aria-hidden="true">→</span></a>
        </nav>
      </div>
      {latestNews.length > 0 && (
        <section class="hero-news" aria-labelledby="hero-news-title">
          <div class="hero-news-heading">
            <div>
              <p class="section-label">NEWS</p>
              <h2 id="hero-news-title">お知らせ</h2>
            </div>
            <a href="/news/">一覧を見る <span aria-hidden="true">→</span></a>
          </div>
          <div class="news-window" aria-label="最新のお知らせから順に表示">
            <div class="news-track" id="news-track">
              {latestNews.map((entry) => (
                <article class="news-card">
                  <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                  <h3><a href={`/news/${entry.id}/`}>{entry.data.title}<span aria-hidden="true">→</span></a></h3>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
  </section>

  <section class="home-section fields-section" aria-labelledby="fields-title">
    <div class="home-container">
      <header class="home-section-heading">
        <p class="section-label">THREE PERSPECTIVES</p>
        <h2 id="fields-title">3つの視点から、多様性をひもとく。</h2>
      </header>
      <div class="field-list">
        {teams.map((team) => (
          <article class:list={["field-item", `field-${team.color}`]}>
            <p class="field-number">{team.number}</p>
            <div class="field-title">
              <p>{team.labelEn}</p>
              <h3>{team.name}</h3>
            </div>
            <p class="field-theme">{team.theme}</p>
          </article>
        ))}
      </div>
      <a class="text-link fields-link" href="/about/#teams">研究領域について詳しく見る <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const intro = document.getElementById("home-intro");
    const skip = document.getElementById("intro-skip");
    if (!intro || !skip) return;

    let alreadySeen = false;
    try { alreadySeen = sessionStorage.getItem("inclusive-science-intro-seen") === "1"; } catch {}
    if (alreadySeen || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      intro.hidden = true;
      return;
    }

    const dismiss = () => {
      intro.classList.add("is-dismissed");
      intro.setAttribute("aria-hidden", "true");
      try { sessionStorage.setItem("inclusive-science-intro-seen", "1"); } catch {}
      window.setTimeout(() => { intro.hidden = true; }, 450);
    };
    const timer = window.setTimeout(dismiss, 2200);
    skip.addEventListener("click", () => { window.clearTimeout(timer); dismiss(); });
  })();
</script>

<script is:inline>
  (() => {
    const track = document.getElementById("news-track");
    if (!track || track.children.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const windowEl = track.parentElement;
    let moving = false;
    const slide = () => {
      if (moving || !windowEl || windowEl.matches(":hover") || windowEl.matches(":focus-within")) return;
      const first = track.firstElementChild;
      if (!first) return;
      moving = true;
      const clone = first.cloneNode(true);
      clone.setAttribute("aria-hidden", "true");
      clone.setAttribute("inert", "");
      track.appendChild(clone);
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = first.getBoundingClientRect().width + gap;
      requestAnimationFrame(() => {
        track.style.transition = "transform .7s ease";
        track.style.transform = `translateX(-${distance}px)`;
      });
      window.setTimeout(() => {
        track.appendChild(first);
        clone.remove();
        track.style.transition = "none";
        track.style.transform = "";
        moving = false;
      }, 750);
    };
    window.setInterval(slide, 5000);
  })();
</script>

<style>
  .home-intro{position:fixed;z-index:100;inset:0;display:flex;align-items:center;background:#faf8f1;transition:opacity .45s ease,visibility .45s ease}
  .home-intro[hidden]{display:none}
  .home-intro.is-dismissed{opacity:0;visibility:hidden;pointer-events:none}
  .home-intro-inner{width:min(var(--content),100%);margin-inline:auto;padding:40px 24px}
  .intro-title{margin:28px 0 45px;font-size:clamp(64px,8vw,104px);line-height:1.17;letter-spacing:-.065em;font-weight:600}
  .intro-title em{color:var(--sage);font-style:normal}
  .intro-skip{padding:9px 0;border:0;border-bottom:1px solid var(--ink);background:none;color:var(--ink);font:600 15px "Noto Sans JP",sans-serif;cursor:pointer}
  .intro-skip span{margin-left:12px}
  .home-hero{position:relative;min-height:650px;padding:130px 24px 72px;display:flex;align-items:center;overflow:hidden;background:#faf8f1}
  .hero-inner{position:relative;z-index:2;width:min(var(--content),100%);margin-inline:auto}
  .hero-kicker,.section-label{margin:0;color:var(--sage);font:700 13px var(--sans);letter-spacing:.12em}
  .home-hero h1{margin:16px 0 8px;font-size:clamp(30px,3.3vw,43px);line-height:1.4;letter-spacing:-.035em;font-weight:600;white-space:nowrap}
  .hero-subtitle{margin:0 0 22px;font-size:clamp(25px,2.6vw,32px);line-height:1.5;font-weight:600;letter-spacing:-.025em}
  .hero-description{max-width:950px;font-size:16px;line-height:1.85}
  .hero-description p{margin:0 0 12px}
  .hero-links{display:flex;flex-wrap:wrap;gap:14px 34px;margin-top:22px}
  .hero-link{display:inline-flex;align-items:center;gap:13px;padding-bottom:6px;border-bottom:1px solid var(--ink);font-size:14px;font-weight:600;text-decoration:none;white-space:nowrap}
  .hero-link span,.text-link span{transition:transform .2s}
  .hero-link:hover span,.hero-link:focus-visible span,.text-link:hover span,.text-link:focus-visible span{transform:translateX(5px)}
  .hero-news{margin-top:48px}
  .hero-news-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:18px}
  .hero-news-heading h2{margin:3px 0 0;font-size:27px;line-height:1.4;font-weight:600}
  .hero-news-heading>a{color:#55755e;font-size:13px;font-weight:600;text-decoration:none}
  .hero-news-heading>a span{margin-left:7px}
  .news-window{overflow:hidden}
  .news-track{display:flex;gap:20px}
  .news-card{flex:0 0 calc((100% - 40px)/3);min-width:0;padding:20px 22px 22px;background:var(--white);border-top:2px solid var(--sage)}
  .news-card time{color:var(--muted);font:600 12px var(--sans);letter-spacing:.04em}
  .news-card h3{margin:11px 0 0;font-size:16px;line-height:1.55;font-weight:600}
  .news-card h3 a{display:flex;gap:12px;color:inherit;text-decoration:none}
  .news-card h3 a span{margin-left:auto;color:var(--sage)}
  .news-card h3 a:hover,.news-card h3 a:focus-visible{color:var(--sage)}
  .home-section{padding:105px 24px 112px}
  .home-container{width:min(var(--content),100%);margin-inline:auto}
  .home-section-heading h2{margin:13px 0 0;font-size:clamp(34px,4vw,43px);line-height:1.45;letter-spacing:-.025em;font-weight:600}
  .text-link{display:inline-flex;align-items:center;gap:14px;margin-top:13px;color:#55755e;font-size:15px;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(85,117,94,.45)}
  .fields-section{background:var(--green-white);padding-top:76px;padding-bottom:82px}
  .home-section-heading{max-width:var(--reading);margin:0 auto 34px}
  .field-list{max-width:var(--reading);margin-inline:auto;border-top:1px solid var(--line)}
  .field-item{display:grid;grid-template-columns:66px minmax(250px,.9fr) minmax(220px,1fr);gap:26px;align-items:center;padding:22px 0 24px;border-bottom:1px solid var(--line)}
  .field-number{margin:0;font:700 30px/1 var(--sans)}
  .field-title>p{margin:0 0 5px;color:var(--muted);font:700 11px var(--sans);letter-spacing:.08em}
  .field-title h3{margin:0;font-size:19px;line-height:1.6;font-weight:600}
  .field-theme{margin:0;font-size:17px;font-weight:600;line-height:1.7}
  .field-red .field-number,.field-red .field-theme{color:var(--coral)}
  .field-green .field-number,.field-green .field-theme{color:var(--sage)}
  .field-blue .field-number,.field-blue .field-theme{color:var(--blue)}
  .fields-link{display:flex;width:max-content;margin:25px auto 0}
  @media(max-width:1100px){.home-hero h1{font-size:clamp(29px,3.2vw,39px)}}
  @media(max-width:900px){.field-item{grid-template-columns:58px minmax(0,1fr)}.field-theme{grid-column:2}.home-hero h1{white-space:normal}.news-card{flex-basis:calc((100% - 20px)/2)}}
  @media(max-width:660px){.home-intro-inner{padding:30px 20px}.intro-title{font-size:clamp(52px,11vw,72px)}.home-hero{min-height:0;padding:125px 20px 66px;align-items:flex-start}.home-hero h1{margin-top:18px;font-size:31px;line-height:1.45}.hero-subtitle{font-size:25px}.hero-description{font-size:15px}.hero-links{gap:11px 24px;margin-top:18px}.hero-link{font-size:13px}.hero-news{margin-top:48px}.hero-news-heading h2{font-size:24px}.news-card{flex-basis:100%}.home-section{padding:76px 20px 82px}.fields-section{padding-top:62px;padding-bottom:68px}.home-section-heading h2{font-size:31px}.home-section-heading{margin-bottom:28px}.field-item{grid-template-columns:44px minmax(0,1fr);gap:14px;padding:19px 0 21px}.field-number{font-size:25px}.field-title>p{font-size:10px}.field-title h3{font-size:17px}.field-theme{font-size:16px}}
</style>
