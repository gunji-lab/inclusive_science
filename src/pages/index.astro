---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { teams } from "../data/teams";

const latestNews = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
---

<BaseLayout
  title="ホーム"
  description="多様性を理解し、つなぎ、活かす新しい科学。東洋大学重点研究推進プロジェクト『インクルーシブ・サイエンス』の公式サイトです。"
>
  <div class="home-intro" id="home-intro" role="dialog" aria-label="サイトの紹介">
    <div class="home-intro-inner">
      <p class="hero-kicker">TOYO UNIVERSITY RESEARCH PROJECT</p>
      <p class="intro-title">多様性を、<br /><em>力に変える。</em></p>
      <button class="intro-skip" id="intro-skip" type="button">トップページを見る <span aria-hidden="true">→</span></button>
    </div>
  </div>
  <noscript><style>.home-intro{display:none!important}</style></noscript>

  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">TOYO UNIVERSITY RESEARCH PROJECT</p>
        <h1 id="home-title">インクルーシブ・<br />サイエンスの創成</h1>
        <p class="hero-lead">生体から生態系まで、多様性の相互作用を理解し、<br />共生社会のあり方を探る研究プロジェクトです。</p>
        <a class="hero-link" href="/about/">プロジェクトについて <span aria-hidden="true">→</span></a>
      </div>
      {latestNews[0] && (
        <aside class="hero-news" aria-label="最新のお知らせ">
          <div class="hero-news-meta">
            <span>NEWS</span>
            <time datetime={latestNews[0].data.date.toISOString()}>{formatDate(latestNews[0].data.date)}</time>
          </div>
          <h2><a href={`/news/${latestNews[0].id}/`}>{latestNews[0].data.title}<span aria-hidden="true">→</span></a></h2>
          <a class="hero-news-all" href="/news/">お知らせ一覧を見る →</a>
        </aside>
      )}
    </div>
  </section>

  <section class="home-section vision-section" aria-labelledby="vision-title">
    <div class="home-container vision-grid">
      <header>
        <p class="section-label">OUR VISION</p>
        <h2 id="vision-title">違いを、<br />科学の中心へ。</h2>
      </header>
      <div class="vision-copy">
        <p>私たち一人ひとりが異なるように、生きものの形や機能、環境への応答にも、さまざまな「違い」があります。生態系や社会もまた、多様な要素の相互作用によって成り立っています。</p>
        <p>本プロジェクトは、これまで「ばらつき」として扱われることもあった個体差や地域差に目を向け、その違いが生命・生態系・社会の持続性にどのような意味を持つのかを明らかにします。</p>
        <a class="text-link" href="/about/">目的と研究計画を読む <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section updates-section" aria-label="研究成果とお知らせ">
    <div class="home-container updates-grid">
      <section class="research-preview" aria-labelledby="research-preview-title">
        <p class="section-label">RESEARCH</p>
        <h2 id="research-preview-title">研究成果</h2>
        <p class="preview-message">本プロジェクトの研究成果を掲載予定です。</p>
        <ul aria-label="掲載予定の研究成果">
          <li><span>01</span> 学会発表</li>
          <li><span>02</span> 査読論文</li>
        </ul>
        <a class="text-link" href="/research/">研究成果を見る <span aria-hidden="true">→</span></a>
      </section>

      <section class="news-preview" aria-labelledby="news-preview-title">
        <div class="preview-heading-row">
          <div>
            <p class="section-label">NEWS</p>
            <h2 id="news-preview-title">お知らせ</h2>
          </div>
          <a class="text-link desktop-news-link" href="/news/">一覧を見る <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-news-list">
          {latestNews.map((entry) => (
            <article>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h3><a href={`/news/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
            </article>
          ))}
        </div>
        <a class="text-link mobile-news-link" href="/news/">お知らせ一覧を見る <span aria-hidden="true">→</span></a>
      </section>
    </div>
  </section>

  <section class="home-section fields-section" aria-labelledby="fields-title">
    <div class="home-container">
      <header class="home-section-heading">
        <p class="section-label">THREE PERSPECTIVES</p>
        <h2 id="fields-title">3つの視点から、多様性をひもとく。</h2>
      </header>
      <div class="field-list">
        {teams.map((team) => (
          <article class:list={["field-item", `field-${team.color}`]}>
            <p class="field-number">{team.number}</p>
            <div class="field-title">
              <p>{team.labelEn}</p>
              <h3>{team.name}</h3>
            </div>
            <p class="field-theme">{team.theme}</p>
          </article>
        ))}
      </div>
      <a class="text-link fields-link" href="/about/#teams">研究領域について詳しく見る <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const intro = document.getElementById("home-intro");
    const skip = document.getElementById("intro-skip");
    if (!intro || !skip) return;

    let alreadySeen = false;
    try { alreadySeen = sessionStorage.getItem("inclusive-science-intro-seen") === "1"; } catch {}
    if (alreadySeen || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      intro.hidden = true;
      return;
    }

    const dismiss = () => {
      intro.classList.add("is-dismissed");
      intro.setAttribute("aria-hidden", "true");
      try { sessionStorage.setItem("inclusive-science-intro-seen", "1"); } catch {}
      window.setTimeout(() => { intro.hidden = true; }, 450);
    };
    const timer = window.setTimeout(dismiss, 2200);
    skip.addEventListener("click", () => { window.clearTimeout(timer); dismiss(); });
  })();
</script>

<style>
  .home-intro{position:fixed;z-index:100;inset:0;display:flex;align-items:center;background:#faf8f1;transition:opacity .45s ease,visibility .45s ease}
  .home-intro[hidden]{display:none}
  .home-intro.is-dismissed{opacity:0;visibility:hidden;pointer-events:none}
  .home-intro-inner{width:min(var(--content),100%);margin-inline:auto;padding:40px 24px}
  .intro-title{margin:28px 0 45px;font-size:clamp(64px,8vw,104px);line-height:1.17;letter-spacing:-.065em;font-weight:600}
  .intro-title em{color:var(--sage);font-style:normal}
  .intro-skip{padding:9px 0;border:0;border-bottom:1px solid var(--ink);background:none;color:var(--ink);font:600 15px "Noto Sans JP",sans-serif;cursor:pointer}
  .intro-skip span{margin-left:12px}
  .home-hero{position:relative;min-height:600px;padding:150px 24px 90px;display:flex;align-items:center;overflow:hidden;background:#faf8f1}
  .hero-inner{position:relative;z-index:2;width:min(var(--content),100%);margin-inline:auto}
  .hero-news{position:absolute;right:0;bottom:8px;width:330px;padding:24px 27px;background:var(--white);border-top:3px solid var(--sage);box-shadow:0 12px 32px rgba(31,46,35,.07)}
  .hero-news-meta{display:flex;align-items:center;gap:16px;color:var(--muted);font:600 12px var(--sans);letter-spacing:.05em}
  .hero-news-meta span{color:var(--sage);font-weight:700;letter-spacing:.12em}
  .hero-news h2{margin:13px 0 17px;font-size:17px;line-height:1.55;font-weight:600}
  .hero-news h2 a{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none}
  .hero-news h2 a span{margin-left:auto;color:var(--sage)}
  .hero-news h2 a:hover,.hero-news h2 a:focus-visible,.hero-news-all:hover,.hero-news-all:focus-visible{color:var(--sage)}
  .hero-news-all{color:#55755e;font-size:12px;font-weight:600;text-decoration:none}
  .hero-kicker,.section-label{margin:0;color:var(--sage);font:700 13px var(--sans);letter-spacing:.12em}
  .home-hero h1{max-width:720px;margin:22px 0 26px;font-size:clamp(42px,4.5vw,58px);line-height:1.4;letter-spacing:-.035em;font-weight:600}
  .hero-lead{max-width:650px;margin:0;font-size:17px;line-height:1.9;letter-spacing:.005em}
  .hero-link{display:inline-flex;align-items:center;gap:18px;margin-top:30px;padding-bottom:7px;border-bottom:1px solid var(--ink);font-size:15px;font-weight:600;text-decoration:none}
  .hero-link span,.text-link span{transition:transform .2s}
  .hero-link:hover span,.hero-link:focus-visible span,.text-link:hover span,.text-link:focus-visible span{transform:translateX(5px)}
  .home-section{padding:105px 24px 112px}
  .home-container{width:min(var(--content),100%);margin-inline:auto}
  .vision-section{background:var(--white)}
  .vision-grid{display:grid;grid-template-columns:minmax(260px,340px) minmax(0,var(--reading));gap:90px;align-items:start}
  .vision-grid h2,.home-section-heading h2,.updates-section h2{margin:13px 0 0;font-size:clamp(34px,4vw,43px);line-height:1.45;letter-spacing:-.025em;font-weight:600}
  .vision-copy{padding-top:2px}
  .vision-copy p{margin:0 0 1.35em;font-size:18px;line-height:1.95}
  .text-link{display:inline-flex;align-items:center;gap:14px;margin-top:13px;color:#55755e;font-size:15px;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(85,117,94,.45)}
  .fields-section{background:var(--green-white);padding-top:76px;padding-bottom:82px}
  .home-section-heading{max-width:var(--reading);margin:0 auto 34px}
  .field-list{max-width:var(--reading);margin-inline:auto;border-top:1px solid var(--line)}
  .field-item{display:grid;grid-template-columns:66px minmax(250px,.9fr) minmax(220px,1fr);gap:26px;align-items:center;padding:22px 0 24px;border-bottom:1px solid var(--line)}
  .field-number{margin:0;font:700 30px/1 var(--sans)}
  .field-title>p{margin:0 0 5px;color:var(--muted);font:700 11px var(--sans);letter-spacing:.08em}
  .field-title h3{margin:0;font-size:19px;line-height:1.6;font-weight:600}
  .field-theme{margin:0;font-size:17px;font-weight:600;line-height:1.7}
  .field-red .field-number,.field-red .field-theme{color:var(--coral)}
  .field-green .field-number,.field-green .field-theme{color:var(--sage)}
  .field-blue .field-number,.field-blue .field-theme{color:var(--blue)}
  .fields-link{display:flex;width:max-content;margin:25px auto 0}
  .updates-section{background:var(--paper)}
  .updates-grid{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.45fr);gap:90px}
  .research-preview{padding-right:56px;border-right:1px solid var(--line)}
  .preview-message{margin:22px 0 28px;font-size:17px;line-height:1.85}
  .research-preview ul{margin:0 0 25px;padding:0;list-style:none;border-top:1px solid var(--line)}
  .research-preview li{padding:14px 0;border-bottom:1px solid var(--line);font-size:16px;font-weight:600}
  .research-preview li span{display:inline-block;width:38px;color:var(--sage);font:700 12px var(--sans)}
  .preview-heading-row{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:25px}
  .desktop-news-link{margin-bottom:8px}
  .home-news-list{border-top:1px solid var(--line)}
  .home-news-list article{display:grid;grid-template-columns:128px minmax(0,1fr);column-gap:24px;padding:25px 0 27px;border-bottom:1px solid var(--line)}
  .home-news-list time{padding-top:4px;color:var(--muted);font:600 13px var(--sans);letter-spacing:.03em}
  .home-news-list h3{margin:0;font-size:18px;line-height:1.65;font-weight:600}
  .home-news-list h3 a{color:inherit;text-decoration:none}
  .home-news-list h3 a:hover,.home-news-list h3 a:focus-visible{color:var(--sage)}
  .home-news-list p{grid-column:2;margin:9px 0 0;color:var(--muted);display:-webkit-box;overflow:hidden;font-size:14px;line-height:1.75;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .mobile-news-link{display:none}
  @media(max-width:900px){.vision-grid{grid-template-columns:1fr;gap:34px}.vision-grid header,.vision-copy{max-width:var(--reading);margin-inline:auto;width:100%}.updates-grid{grid-template-columns:1fr;gap:70px}.research-preview{padding-right:0;border-right:0}.field-item{grid-template-columns:58px minmax(0,1fr)}.field-theme{grid-column:2}}
  @media(max-width:1100px){.hero-news{width:280px}.home-hero h1{font-size:clamp(42px,4.5vw,54px)}}
  @media(max-width:900px){.hero-news{position:static;width:min(420px,100%);margin-top:42px}.home-hero{min-height:0}}
  @media(max-width:660px){.home-intro-inner{padding:30px 20px}.intro-title{font-size:clamp(52px,11vw,72px)}.home-hero{padding:130px 20px 72px;align-items:flex-start}.home-hero h1{margin-top:24px;font-size:38px;line-height:1.4}.hero-lead{font-size:16px}.hero-lead br{display:none}.home-section{padding:76px 20px 82px}.fields-section{padding-top:62px;padding-bottom:68px}.vision-grid h2,.home-section-heading h2,.updates-section h2{font-size:31px}.vision-copy p{font-size:17px}.home-section-heading{margin-bottom:28px}.field-item{grid-template-columns:44px minmax(0,1fr);gap:14px;padding:19px 0 21px}.field-number{font-size:25px}.field-title>p{font-size:10px}.field-title h3{font-size:17px}.field-theme{font-size:16px}.updates-grid{gap:65px}.preview-heading-row{align-items:flex-start}.desktop-news-link{display:none}.home-news-list article{grid-template-columns:1fr;gap:7px}.home-news-list p{grid-column:1;margin-top:2px}.mobile-news-link{display:inline-flex;margin-top:28px}}
</style>
