---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("news", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);

const categoryLabels = {
  news: "NEWS",
  event: "EVENT",
  research: "RESEARCH",
  media: "MEDIA",
};
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="news-detail">
    <div class="news-detail-container">
      <header class="news-detail-heading">
        <a class="back-link" href="/news/">← お知らせ一覧</a>
        <div class="news-detail-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>{categoryLabels[entry.data.category]}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="news-detail-summary">{entry.data.summary}</p>
      </header>
      <div class="news-detail-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .news-detail{min-height:calc(100vh - 130px);padding:116px 24px 70px;background:var(--paper)}
  .news-detail-container{width:min(var(--reading),100%);margin-inline:auto}
  .back-link{display:inline-block;margin-bottom:24px;color:var(--sage);font-size:14px;font-weight:600;text-decoration:none}
  .news-detail-meta{display:flex;align-items:center;gap:18px;color:var(--muted);font:600 14px var(--sans);letter-spacing:.04em}
  .news-detail-meta span{color:var(--sage);font-size:12px;letter-spacing:.1em}
  .news-detail-heading h1{margin:22px 0 20px;font-size:clamp(34px,5vw,50px);line-height:1.45;letter-spacing:-.03em;font-weight:600}
  .news-detail-summary{margin:0;font-size:18px;line-height:1.9}
  .news-detail-body{margin-top:36px;padding-top:30px;border-top:1px solid var(--line);font-size:17px;line-height:1.8}
  .news-detail-body :global(h2){margin:2em 0 .7em;font-size:28px;line-height:1.55;font-weight:600}
  .news-detail-body :global(h2:first-child){margin-top:0}
  .news-detail-body :global(h3){margin:1.8em 0 .8em;font-size:22px;line-height:1.7;font-weight:600}
  .news-detail-body :global(p){margin:0 0 1.1em}
  .news-detail-body :global(ul){margin:1.7em 0;padding:22px 28px 22px 50px;background:var(--white);border-left:3px solid var(--sage)}
  .news-detail-body :global(li){margin:.45em 0}
  @media(max-width:660px){.news-detail{padding:100px 20px 58px}.news-detail-heading h1{font-size:32px}.news-detail-summary,.news-detail-body{font-size:16px}.news-detail-body{margin-top:28px;padding-top:24px}.news-detail-body :global(h2){font-size:24px}.news-detail-body :global(h3){font-size:20px}}
</style>
