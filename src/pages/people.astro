---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import MemberCard from "../components/MemberCard.astro";
import { membersByTeam, operations } from "../data/members";
import { teams } from "../data/teams";

const teamMembers = new Map(teams.map((team) => [team.id, membersByTeam(team.id)]));
---

<BaseLayout
  title="組織・メンバー"
  description="インクルーシブ・サイエンスを推進するプロジェクト運営体制と研究メンバーをご紹介します。"
>
  <section class="people-intro" aria-labelledby="people-title">
    <div class="people-intro-inner">
      <p class="eyebrow">PEOPLE <span>組織・メンバー</span></p>
      <h1 id="people-title">異なる専門性が、<br /><em>ひとつの問い</em>に向き合う。</h1>
      <p>生命科学、生態学、社会科学、データ科学。<br />多様な視点を持つ研究者が、分野の境界を越えて協働します。</p>
    </div>
    <div class="people-motif" aria-hidden="true"><i></i><i></i><i></i></div>
  </section>

  <nav class="people-jump" aria-label="ページ内ナビゲーション">
    <a href="#organization">運営体制</a>
    {teams.map((team) => <a href={`#${team.id}`}>{team.number} {team.name.replace("グループ", "")}</a>)}
  </nav>

  <section id="organization" class="section organization-section" aria-labelledby="organization-title">
    <div class="section-container">
      <SectionHeading number="01" eyebrow="ORGANIZATION" title="プロジェクト運営体制" id="organization-title" />
      <div class="section-lead reveal">
        <p>研究領域を横断する連携と、継続的な情報発信を支える運営体制です。各研究グループの知見をつなぎ、プロジェクト全体の方向性を共有します。</p>
      </div>
      <div class="operation-list reveal">
        {operations.map((member) => <MemberCard member={member} />)}
      </div>
    </div>
  </section>

  <section class="section research-members-section" aria-labelledby="research-members-title">
    <div class="section-container">
      <SectionHeading number="02" eyebrow="RESEARCH MEMBERS" title="研究メンバー" id="research-members-title" />
      <div class="section-lead reveal">
        <p>3つの研究領域を基盤に、専門の異なる研究者が知見とデータを持ち寄ります。グループの枠を越えた連携から、インクルーシブ・サイエンスを形づくります。</p>
      </div>

      <div class="research-groups">
        {teams.map((team) => {
          const listedMembers = teamMembers.get(team.id) ?? [];
          return (
            <section id={team.id} class:list={["research-group", `research-group-${team.color}`]} aria-labelledby={`${team.id}-title`}>
              <header class="research-group-header reveal">
                <p class="group-number">{team.number}</p>
                <div>
                  <p class="group-label">{team.labelEn}</p>
                  <h2 id={`${team.id}-title`}>{team.name}</h2>
                  <p class="group-theme">{team.theme}</p>
                </div>
              </header>
              {listedMembers.length > 0 ? (
                <div class="member-grid reveal">
                  {listedMembers.map((member) => <MemberCard member={member} compact />)}
                </div>
              ) : (
                <p class="members-pending reveal">メンバー情報は、確認後に掲載します。</p>
              )}
            </section>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .people-intro{position:relative;min-height:560px;padding:160px 24px 96px;display:flex;align-items:center;overflow:hidden;background:linear-gradient(135deg,var(--paper),#edf2ec)}
  .people-intro-inner{position:relative;z-index:2;width:min(1080px,100%);margin-inline:auto}
  .people-intro h1{max-width:820px;margin:20px 0 30px;font-size:clamp(48px,6.2vw,78px);line-height:1.28;letter-spacing:-.05em;font-weight:600}
  .people-intro h1 em{color:var(--sage);font-style:normal}
  .people-intro-inner>p:last-child{margin:0;font-size:19px;line-height:1.9}
  .people-motif{position:absolute;right:8%;bottom:70px;width:300px;height:230px;opacity:.72}
  .people-motif i{position:absolute;width:148px;height:148px;border:3px solid;border-radius:48% 52% 44% 56%/52% 42% 58% 48%;transform:rotate(18deg)}
  .people-motif i:nth-child(1){left:0;top:10px;color:var(--coral)}
  .people-motif i:nth-child(2){right:0;top:0;color:var(--sage);transform:rotate(-22deg)}
  .people-motif i:nth-child(3){left:78px;bottom:0;color:var(--blue);transform:rotate(44deg)}
  .people-jump{position:sticky;z-index:20;top:82px;padding:15px 24px;display:flex;justify-content:center;gap:10px;overflow-x:auto;background:rgba(255,254,250,.95);border-block:1px solid var(--line);backdrop-filter:blur(12px)}
  .people-jump a{flex:0 0 auto;padding:7px 13px;color:var(--muted);font-size:13px;font-weight:600;text-decoration:none;border-radius:999px}
  .people-jump a:hover,.people-jump a:focus-visible{color:var(--ink);background:var(--ivory)}
  .organization-section{background:var(--white)}
  .research-members-section{background:var(--green-white)}
  .section-lead{max-width:var(--reading);margin:-18px auto 48px}
  .section-lead p{margin:0;font-size:18px;line-height:1.9}
  .operation-list{max-width:var(--reading);margin-inline:auto;border-bottom:1px solid var(--line)}
  .research-groups{max-width:var(--reading);margin:0 auto}
  .research-group{padding:70px 0 36px;scroll-margin-top:145px;border-top:1px solid var(--line)}
  .research-group-header{display:grid;grid-template-columns:78px minmax(0,1fr);gap:24px;margin-bottom:30px}
  .group-number{margin:5px 0 0;font:700 38px/1 var(--sans)}
  .group-label{margin:0 0 8px;color:var(--muted);font:700 13px var(--sans);letter-spacing:.09em}
  .research-group h2{margin:0;font-size:30px;line-height:1.5;font-weight:600;letter-spacing:-.02em}
  .group-theme{margin:8px 0 0;font-size:18px;font-weight:600}
  .research-group-red .group-number,.research-group-red .group-theme{color:var(--coral)}
  .research-group-green .group-number,.research-group-green .group-theme{color:var(--sage)}
  .research-group-blue .group-number,.research-group-blue .group-theme{color:var(--blue)}
  .member-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:44px;border-bottom:1px solid var(--line)}
  .members-pending{margin:0;padding:28px 0 32px;border-block:1px solid var(--line);color:var(--muted);font-size:16px}
  @media(max-width:900px){.people-motif{right:-70px;opacity:.38}.member-grid{grid-template-columns:1fr}.people-jump{justify-content:flex-start}}
  @media(max-width:660px){.people-intro{min-height:520px;padding:135px 20px 72px}.people-intro h1{font-size:45px}.people-intro-inner>p:last-child{font-size:17px}.people-intro-inner>p:last-child br{display:none}.people-motif{right:-105px;bottom:25px;transform:scale(.72)}.people-jump{top:70px;padding:11px 16px}.section-lead{margin-top:-8px;margin-bottom:38px}.section-lead p{font-size:17px}.research-group{padding-top:56px}.research-group-header{grid-template-columns:1fr;gap:13px}.group-number{font-size:31px}.research-group h2{font-size:25px}.group-theme{font-size:17px}}
</style>
